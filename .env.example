FLASK_ENV=development
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production refuses to start while these contain "change-me".
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_SECRET_KEY=change-me-to-another-long-random-string-at-least-32-chars

# SQLite by default; use postgresql://user:pass@host:5432/dbname for production
DATABASE_URL=sqlite:///elevator_chip.db
# Apply pending migrations on startup (defaults to false when FLASK_ENV=production; run `flask db upgrade`)
AUTO_MIGRATE=true

# Seeded admin account (created on first startup if missing; password is only used at creation)
# Production refuses to start with the default password or one shorter than 12 characters.
ADMIN_PHONE=+995591000001
ADMIN_PASSWORD=ChangeMeAdmin123!
ADMIN_ID_NUMBER=01011000001

# Default region when phone numbers are entered without a country code (Georgia)
DEFAULT_PHONE_REGION=GE

# JWT token lifetime in seconds (default 1 hour)
JWT_ACCESS_TOKEN_EXPIRES=3600

# Rate limiting storage (memory:// for dev; redis://localhost:6379 for production)
RATELIMIT_STORAGE_URI=memory://

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Security
# Interactive debugger; never enable on a server reachable by others
FLASK_DEBUG=false
# Dev server bind address (127.0.0.1 = this machine only)
HOST=127.0.0.1
# Send session cookie over HTTPS only (defaults to true when FLASK_ENV=production)
SESSION_COOKIE_SECURE=false
# Swagger UI at /api/v1/docs (defaults to false when FLASK_ENV=production)
API_DOCS_ENABLED=true
# Number of reverse proxies in front of the app (1 behind nginx), so rate limits see real client IPs
PROXY_FIX_X_FOR=0
MAX_UPLOAD_MB=5
LOGIN_RATE_LIMIT_PER_IP="20 per minute"
LOGIN_RATE_LIMIT_PER_ACCOUNT="5 per 15 minutes"

# Public website
DEFAULT_LANGUAGE=ka
CONTACT_RATE_LIMIT="5 per hour"
CONTACT_ATTEMPT_RATE_LIMIT="30 per hour"

# Company details shown on the public website (placeholders, replace with real values)
COMPANY_NAME="Digital X Control"
COMPANY_LEGAL_NAME="DXC LLC"
COMPANY_TAX_ID=405123456
COMPANY_PHONE=+995322001122
COMPANY_EMAIL=info@dxc.ge
COMPANY_ADDRESS_EN="12 Vazha-Pshavela Ave, Tbilisi 0186, Georgia"
COMPANY_ADDRESS_KA="ვაჟა-ფშაველას გამზ. 12, თბილისი 0186, საქართველო"
COMPANY_HOURS_EN="Mon-Fri 10:00-19:00, Sat 11:00-16:00"
COMPANY_HOURS_KA="ორშ-პარ 10:00-19:00, შაბ 11:00-16:00"
COMPANY_MAP_URL=https://maps.google.com/?q=Vazha-Pshavela+Ave+12+Tbilisi
COMPANY_FACEBOOK_URL=https://facebook.com/dxc.georgia
COMPANY_INSTAGRAM_URL=https://instagram.com/dxc.georgia

# Bank accounts customers pay into (shown in the user portal "How to pay" section)
BANK_RECIPIENT_NAME="DXC LLC"
BANK_1_NAME="TBC Bank"
BANK_1_IBAN=GE29TB7894561230000001
BANK_2_NAME="Bank of Georgia"
BANK_2_IBAN=GE60BG0000000123456789

# Outgoing email (contact form notifications). Fill in before enabling.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
# Where new contact-form requests are sent
CONTACT_NOTIFY_EMAIL=
